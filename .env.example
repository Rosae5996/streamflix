# =============================================================================
# StreamFlix - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE (Required)
# =============================================================================
# MySQL connection string
DATABASE_URL=mysql://user:password@host:3306/streamflix

# =============================================================================
# SUPABASE AUTH (Required for OAuth)
# =============================================================================
# Get these from your Supabase project settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (for server-side operations)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =============================================================================
# JWT & SECURITY (Required)
# =============================================================================
# Secret for signing JWT tokens (generate a random 32+ character string)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# =============================================================================
# PAYPAL (Required for subscriptions)
# =============================================================================
# Get these from PayPal Developer Dashboard
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# Use "sandbox" for testing, "live" for production
PAYPAL_MODE=sandbox
# Webhook ID for signature verification (get from PayPal Developer Dashboard)
# Create a webhook at: https://developer.paypal.com/dashboard/applications/sandbox
# Set the webhook URL to: https://your-domain.vercel.app/api/paypal/webhook
PAYPAL_WEBHOOK_ID=your-webhook-id

# =============================================================================
# OWNER / ADMIN (Required)
# =============================================================================
# The OpenID of the owner account (gets admin role automatically)
OWNER_OPEN_ID=your-owner-open-id

# =============================================================================
# APPLICATION (Optional)
# =============================================================================
# Application ID for OAuth
VITE_APP_ID=streamflix

# Port to run the server (default: 3000)
PORT=3000

# Environment: development or production
NODE_ENV=production

# =============================================================================
# OAUTH (Optional - if using Manus OAuth)
# =============================================================================
OAUTH_SERVER_URL=
OAUTH_PROVIDER_ID=

# =============================================================================
# FORGE API (Optional - for AI features)
# =============================================================================
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
