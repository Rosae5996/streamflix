# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare R2 Configuration
CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-key
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET_NAME=streamflix-media
CLOUDFLARE_R2_PUBLIC_URL=https://cdn.streamflix.com

# PayPal Configuration
PAYPAL_CLIENT_ID=your-client-id
PAYPAL_CLIENT_SECRET=your-client-secret
PAYPAL_PRODUCT_ID=your-product-id
PAYPAL_PLAN_MONTHLY_ID=your-monthly-plan-id
PAYPAL_PLAN_ANNUAL_ID=your-annual-plan-id
PAYPAL_WEBHOOK_ID=your-webhook-id
NEXT_PUBLIC_PAYPAL_MODE=sandbox  # Use 'live' in production

# Security
NODE_ENV=development
